{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/app/**",
      "/alembic/**",
      "/alembic.ini",
      "/pyproject.toml",
      "/run.py",
      "/Dockerfile",
      "/railway.worker.json"
    ]
  },
  "deploy": {
    "startCommand": "python -m app.worker",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "sleepApplication": false
  }
}
