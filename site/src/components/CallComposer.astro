---
// "Describe the call" box. The three examples fill the box and show their ready-made
// call plan. Anything else goes to the planner (demo/worker POST /plans) when this
// build has a demo backend; without one, submitting explains that live planning
// opens soon, and keeps what the visitor typed.
// Props: `examples` shows the three use-case chips and their plans (the homepage);
// `ideas` are other purposes that only fill the box, for pages that list the use cases
// already and want starting points that aren't repeats.
import { USE_CASES } from "../use-cases";
import CallDialog from "./CallDialog.astro";

interface Props {
  examples?: boolean;
  ideas?: { label: string; text: string }[];
}
const { examples = true, ideas = [] } = Astro.props;
---

<div class="composer" data-composer>
  <form class="composer-form" novalidate>
    <label class="composer-label" for="purpose">What should the call be about?</label>
    <textarea
      id="purpose"
      name="purpose"
      rows="3"
      maxlength="500"
      placeholder="Call customers who missed a delivery yesterday. Find a new delivery day and note any instructions for the driver."
    ></textarea>
    <div class="composer-bar">
      <span class="composer-hint">Plain English is fine. <span class="composer-count" aria-live="polite"><span data-count>0</span>/500</span></span>
      <button class="composer-go" type="submit" aria-label="Plan the call"><span class="wd-arrow" aria-hidden="true">→</span></button>
    </div>
  </form>

  {examples && (
    <div class="composer-examples">
      <span class="composer-examples-label">Try one:</span>
      {USE_CASES.map((u) => (
        <button type="button" class:list={["wd-chip", `wd-chip--${u.tint}`]} data-example={u.slug}>
          <span class:list={["wd-avatar", `wd-avatar--${u.tint}`]} aria-hidden="true">{u.agent.name[0]}</span>{u.chip}
        </button>
      ))}
    </div>
  )}

  {ideas.length > 0 && (
    <div class="composer-examples">
      <span class="composer-examples-label">Start from an idea:</span>
      {ideas.map((i) => (
        <button type="button" class="wd-chip" data-idea={i.text}>{i.label}</button>
      ))}
    </div>
  )}

  <p class="composer-status" data-status aria-live="polite"></p>
  <p class="composer-notice" data-notice hidden data-offline-text={`Planning your own call opens with the live demo, soon. Meanwhile, ${examples ? "try one of the examples" : "see how the use cases above go in their sample calls"}.`}></p>

  <section class="plan" data-plan="custom" hidden aria-label="Call plan: your call">
    <div class="plan-head">
      <span class="plan-title">Here’s the plan</span>
      <span class="wd-badge">Your call</span>
    </div>
    <dl class="plan-grid">
      <div><dt>The agent</dt><dd data-slot="agent"></dd></div>
      <div><dt>Opens with</dt><dd data-slot="opens"></dd></div>
      <div><dt>Goal</dt><dd data-slot="goal"></dd></div>
      <div><dt>Writes down</dt><dd><ul class="plan-fields" data-slot="fields"></ul></dd></div>
      <div><dt>Made up for the call</dt><dd><ul class="plan-facts" data-slot="facts"></ul></dd></div>
      <div><dt>You play</dt><dd data-slot="brief"></dd></div>
    </dl>
    <div class="plan-actions">
      <button class="wd-btn wd-btn--primary" type="button" data-start disabled>Start the call</button>
      <button class="wd-btn wd-btn--secondary" type="button" data-edit>Edit the plan</button>
    </div>
    <p class="plan-note" data-slot="note"></p>
  </section>
  <CallDialog />

  {examples && USE_CASES.map((u) => (
    <section
      class="plan"
      data-plan={u.slug}
      data-purpose={u.purpose}
      data-call={JSON.stringify({ request: { use_case: u.slug }, agent: u.agent, brief: u.brief, fields: u.fields.map(({ key, label }) => ({ key, label })) })}
      hidden
      aria-label={`Call plan: ${u.title}`}
    >
      <div class="plan-head">
        <span class="plan-title">Here’s the plan</span>
        <span class="wd-badge">Example</span>
      </div>
      <dl class="plan-grid">
        <div><dt>The agent</dt><dd>{u.agent.name}, {u.agent.role} at {u.agent.company}</dd></div>
        <div><dt>Opens with</dt><dd>“{u.firstMessage}”</dd></div>
        <div><dt>Goal</dt><dd>{u.goal}</dd></div>
        <div><dt>Writes down</dt><dd><ul class="plan-fields">{u.fields.map((f) => <li>{f.label}</li>)}</ul></dd></div>
        <div><dt>You play</dt><dd>{u.brief}</dd></div>
      </dl>
      <div class="plan-actions">
        <button class="wd-btn wd-btn--primary" type="button" data-start disabled>Start the call</button>
        <a class="wd-btn wd-btn--secondary" href={`/use-cases/${u.slug}/`}>Hear a sample call</a>
      </div>
      <p class="plan-note" data-live-note="You talk to the agent in your browser, playing the other side of the call.">Live calls in your browser open soon. Until then, hear how this call goes in the sample.</p>
    </section>
  ))}
</div>

<script>
  import { DemoError, demoEnabled, demoStatus, planCall, statusMessage, type Plan } from "../demo/client";
  import { planEditor } from "../demo/plan-editor";

  for (const root of document.querySelectorAll<HTMLElement>("[data-composer]")) {
    const form = root.querySelector("form")!;
    const box = root.querySelector<HTMLTextAreaElement>("textarea")!;
    const count = root.querySelector<HTMLElement>("[data-count]")!;
    const notice = root.querySelector<HTMLElement>("[data-notice]")!;
    const status = root.querySelector<HTMLElement>("[data-status]")!;
    const go = root.querySelector<HTMLButtonElement>(".composer-go")!;
    const custom = root.querySelector<HTMLElement>('[data-plan="custom"]')!;
    const plans = [...root.querySelectorAll<HTMLElement>("[data-plan]:not([data-plan=custom])")];
    let planned = ""; // the purpose the custom plan was made for

    // "Start the call" opens the call dialog (CallDialog.astro).
    if (demoEnabled) {
      for (const btn of root.querySelectorAll<HTMLButtonElement>("[data-start]")) {
        btn.disabled = false;
        btn.addEventListener("click", () => {
          const section = btn.closest<HTMLElement>("[data-plan]")!;
          const detail = section.dataset.call ? JSON.parse(section.dataset.call) : null;
          if (detail) document.dispatchEvent(new CustomEvent("offhook:call", { detail }));
        });
      }
      for (const note of root.querySelectorAll<HTMLElement>("[data-live-note]")) note.textContent = note.dataset.liveNote!;
      void checkStatus();
    }

    /** Disables "Start the call" with a reason when the demo is offline, busy or paused. */
    let unavailable: string | null = null;
    async function checkStatus() {
      unavailable = statusMessage(await demoStatus());
      for (const btn of root.querySelectorAll<HTMLButtonElement>("[data-start]")) btn.disabled = Boolean(unavailable);
      for (const note of root.querySelectorAll<HTMLElement>("[data-live-note], [data-slot=note]")) {
        note.classList.toggle("plan-note--warn", Boolean(unavailable));
        if (unavailable) note.textContent = unavailable;
        else if (note.dataset.liveNote) note.textContent = note.dataset.liveNote;
      }
    }

    // Editing the custom plan before calling.
    let customPlan: Plan | null = null;
    let plansLeft = 0;
    const editBtn = root.querySelector<HTMLButtonElement>("[data-edit]")!;
    editBtn.hidden = !demoEnabled;
    editBtn.addEventListener("click", () => {
      if (!customPlan) return;
      const view = [custom.querySelector<HTMLElement>(".plan-grid")!, custom.querySelector<HTMLElement>(".plan-actions")!];
      view.forEach((v) => (v.hidden = true));
      const done = () => {
        editor.remove();
        view.forEach((v) => (v.hidden = false));
        editBtn.focus();
      };
      const editor = planEditor(
        customPlan,
        (plan) => {
          setCustom(plan);
          done();
        },
        done,
      );
      view[0].after(editor);
      editor.querySelector<HTMLInputElement>("input")?.focus();
    });

    /** Shows `plan` in the custom card and makes it the plan "Start the call" uses. */
    function setCustom(plan: Plan) {
      customPlan = plan;
      fill(custom, plan, plansLeft);
      custom.dataset.call = JSON.stringify({ request: { plan }, agent: plan.agent, brief: plan.brief, fields: plan.fields });
      if (unavailable) slotNote();
    }
    function slotNote() {
      const note = custom.querySelector<HTMLElement>("[data-slot=note]")!;
      note.textContent = unavailable ?? note.textContent;
      note.classList.toggle("plan-note--warn", Boolean(unavailable));
    }
    const chips = [...root.querySelectorAll<HTMLButtonElement>("[data-example]")];
    const ideas = [...root.querySelectorAll<HTMLButtonElement>("[data-idea]")];

    const show = (slug: string | null) => {
      for (const p of plans) p.hidden = p.dataset.plan !== slug;
      custom.hidden = slug !== "custom";
      for (const c of chips) c.setAttribute("aria-pressed", String(c.dataset.example === slug));
      notice.hidden = true;
    };
    const tell = (message: string) => {
      notice.textContent = message;
      notice.hidden = false;
    };
    const updateCount = () => (count.textContent = String(box.value.length));
    const matching = () => plans.find((p) => p.dataset.purpose === box.value.trim())?.dataset.plan ?? null;

    for (const chip of chips) {
      chip.addEventListener("click", () => {
        const plan = plans.find((p) => p.dataset.plan === chip.dataset.example)!;
        box.value = plan.dataset.purpose ?? "";
        updateCount();
        show(chip.dataset.example ?? null);
        plan.scrollIntoView({ block: "nearest", behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
      });
    }

    for (const idea of ideas) {
      idea.addEventListener("click", () => {
        box.value = idea.dataset.idea ?? "";
        updateCount();
        show(null);
        for (const i of ideas) i.setAttribute("aria-pressed", String(i === idea));
        box.focus();
      });
    }

    box.addEventListener("input", () => {
      for (const i of ideas) i.setAttribute("aria-pressed", "false");
      updateCount();
      // Editing an example's text turns it into a custom purpose: hide the ready-made plan.
      if (!matching() && box.value.trim() !== planned) show(null);
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const slug = matching();
      if (slug) return show(slug);
      show(null);
      const purpose = box.value.trim();
      if (!purpose) {
        box.focus();
        return;
      }
      if (!demoEnabled) return tell(notice.dataset.offlineText ?? "");
      if (purpose === planned) return show("custom");

      go.disabled = true;
      go.setAttribute("aria-busy", "true");
      status.textContent = "Planning your call…";
      try {
        const res = await planCall(purpose);
        if (res.status === "refused") {
          tell(`We can't plan that call. ${res.reason}`);
        } else {
          plansLeft = res.plans_left;
          setCustom(res.plan);
          void checkStatus();
          planned = purpose;
          show("custom");
          custom.scrollIntoView({ block: "nearest", behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
        }
      } catch (e) {
        tell(e instanceof DemoError ? e.message : "Something went wrong. Try again in a moment.");
      } finally {
        go.disabled = false;
        go.removeAttribute("aria-busy");
        status.textContent = "";
      }
    });
  }

  /**
   * Puts a planner's plan into the custom plan card. Everything is set as text,
   * never HTML: it comes from a model.
   * Args: card — the custom plan section; plan — from POST /plans; left — plans left today.
   */
  function fill(card: HTMLElement, plan: Plan, left: number) {
    const slot = (name: string) => card.querySelector<HTMLElement>(`[data-slot="${name}"]`)!;
    slot("agent").textContent = `${plan.agent.name}, ${plan.agent.role} at ${plan.agent.company}`;
    slot("opens").textContent = `“${plan.firstMessage}”`;
    slot("goal").textContent = plan.goal;
    slot("brief").textContent = plan.brief;
    const list = (name: string, items: string[]) => {
      const ul = slot(name);
      ul.replaceChildren(...items.map((t) => Object.assign(document.createElement("li"), { textContent: t })));
      ul.closest("div")!.hidden = items.length === 0;
    };
    list("fields", plan.fields.map((f) => f.label));
    list("facts", Object.entries(plan.assumptions).map(([k, v]) => `${k.replace(/_/g, " ")}: ${v}`));
    slot("note").textContent = `You talk to the agent in your browser, playing the other side of the call. ${left === 1 ? "1 plan" : `${left} plans`} left today.`;
  }
</script>
