---
import ThemeHead from "../components/ThemeHead.astro";
import ThemeSwitch from "../components/ThemeSwitch.astro";
import OffhookLogo from "../components/OffhookLogo.astro";
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
const ogAlt = "Offhook, by welldun: describe the call and it makes it. An example call where Alex from Acme Clinic moves an appointment.";
const GITHUB = "https://github.com/welldunai/offhook";
// The hosted dashboard: it shows your workspace if you're signed in, and sign-in
// (with sign-up) if you're not.
const APP = "https://app.offhook.welldun.ai";
// Cloudflare Web Analytics: cookieless visit counts, referrers and countries.
const BEACON = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const NAV = [
  { label: "Use cases", href: "/use-cases/" },
  { label: "Docs", href: "/docs/" },
  { label: "Quickstart", href: "/docs/quickstart/" },
  { label: "API", href: "/docs/calls/" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <ThemeHead />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Offhook" />
    <meta name="application-name" content="Offhook" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <link rel="preload" href="/fonts/Figtree.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="wd-header">
      <div class="wd-container wd-header-inner">
        <div class="oh-brand">
          <OffhookLogo />
          <span class="oh-by">by welldun<span class="oh-by-dot">.</span></span>
        </div>
        <nav class="wd-nav" aria-label="Main">
          {NAV.map((l) => <a href={l.href} aria-current={l.href !== "/docs/" && Astro.url.pathname === l.href ? "page" : l.href === "/docs/" && Astro.url.pathname.startsWith("/docs/") && !NAV.some((n) => n.href !== "/docs/" && Astro.url.pathname === n.href) ? "page" : undefined}>{l.label}</a>)}
        </nav>
        <div class="wd-header-actions">
          <a class="oh-icon-btn" href={GITHUB} aria-label="View on GitHub" title="View on GitHub">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" /></svg>
          </a>
          <a class="wd-btn wd-btn--primary wd-btn--sm" href={APP} data-app-link>Sign in</a>
        </div>
      </div>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer class="wd-footer">
      <div class="wd-container wd-footer-inner">
        <div class="oh-foot">
          <OffhookLogo />
          <span>Open source under Apache-2.0. Powered by <span class="oh-powered">welldun<span class="oh-by-dot">.</span></span></span>
        </div>
        <nav class="wd-footer-links" aria-label="Footer">
          <a href={APP} data-app-link>Sign in</a>
          <a href={GITHUB}>GitHub</a>
          <a href="/docs/">Docs</a>
          <a href="https://x.com/welldunai">X</a>
        </nav>
        <ThemeSwitch />
      </div>
    </footer>

    <script>
      // "Sign in" says "Dashboard" when Clerk's signed-in marker (__client_uat, a
      // timestamp; 0 when signed out) is visible to this site. The link is the same
      // either way: the dashboard handles both.
      const signedIn = /(?:^|;\s*)__client_uat=([1-9]\d*)/.test(document.cookie);
      if (signedIn) for (const a of document.querySelectorAll<HTMLAnchorElement>("[data-app-link]")) a.textContent = "Dashboard";

      // Header shadow after scroll.
      const head = document.querySelector(".wd-header");
      const onScroll = () => head?.setAttribute("data-scrolled", String(window.scrollY > 4));
      onScroll();
      addEventListener("scroll", onScroll, { passive: true });

      // Code blocks: tabs switch panels; copy copies the visible panel.
      for (const block of document.querySelectorAll<HTMLElement>(".wd-code")) {
        const tabs = [...block.querySelectorAll<HTMLButtonElement>(".wd-code-tab")];
        const panels = [...block.querySelectorAll<HTMLElement>("pre")];
        tabs.forEach((tab, i) =>
          tab.addEventListener("click", () => {
            tabs.forEach((t, j) => t.setAttribute("aria-selected", String(i === j)));
            panels.forEach((p, j) => (p.hidden = i !== j));
          }),
        );
        const copy = block.querySelector<HTMLButtonElement>(".wd-code-copy");
        copy?.addEventListener("click", async () => {
          const pre = panels.find((p) => !p.hidden) ?? panels[0];
          let label = "Copied";
          try {
            await navigator.clipboard.writeText(pre.innerText);
          } catch {
            const range = document.createRange();
            range.selectNodeContents(pre);
            const sel = getSelection();
            sel?.removeAllRanges();
            sel?.addRange(range);
            label = "Selected";
          }
          copy.textContent = label;
          setTimeout(() => (copy.textContent = "Copy"), 1400);
        });
      }
    </script>
    {BEACON && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: BEACON })}></script>
    )}
  </body>
</html>
