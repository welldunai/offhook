---
import Base from "../layouts/Base.astro";
import Code from "../components/Code.astro";
import { USE_CASES } from "../use-cases";
import CallComposer from "../components/CallComposer.astro";

const GITHUB = "https://github.com/welldunai/offhook";

const teamSteps = [
  { title: "Describe the call", body: "Say who the agent is calling and what you need to find out, the way you'd brief a colleague. No scripts or call flows to draw." },
  { title: "Offhook plans it", body: "It turns your description into a call plan: who the agent is, how it opens, what it asks, and which answers to record. You can change any of it." },
  { title: "It calls and reports back", body: "The agent holds a natural conversation and handles the back and forth. You get structured answers, a summary and the full transcript for every call." },
];

const steps = [
  {
    title: "Connect your keys",
    body: "Register your Deepgram, Cartesia, LLM and carrier keys as connections. Each one is encrypted with a key that belongs to your account, and decrypted only while a call is running.",
  },
  {
    title: "Define an agent",
    body: "Give it instructions, an opening line, a voice and a model, and pick the connections it runs on. Reuse the same agent across every call.",
  },
  {
    title: "Place the call",
    body: "Send a phone number and any facts the agent should know. A worker dials, the agent talks, and you get a webhook at every step until the call ends.",
  },
];

const stepCode = [
  {
    label: "1 · connections",
    code: `curl -X POST localhost:8000/v1/connections \\
  -H "Authorization: Bearer $OFFHOOK_KEY" \\
  -H "content-type: application/json" \\
  -d '{
    "name": "my-groq",
    "provider_kind": "llm",
    "provider_name": "groq",
    "secrets": {"api_key": "gsk_..."}
  }'`,
  },
  {
    label: "2 · agents",
    code: `curl -X POST localhost:8000/v1/agents \\
  -H "Authorization: Bearer $OFFHOOK_KEY" \\
  -H "content-type: application/json" \\
  -d '{
    "name": "Alex",
    "company": "Acme Clinic",
    "instructions": "Confirm the appointment; offer to reschedule if needed.",
    "first_message": "Hi, this is Alex from Acme Clinic. Am I speaking with Priya?",
    "stt_connection_id": "<stt-connection-id>",
    "tts_connection_id": "<tts-connection-id>",
    "llm_connection_id": "<llm-connection-id>",
    "telephony_connection_id": "<telephony-connection-id>"
  }'`,
  },
  {
    label: "3 · calls",
    code: `curl -X POST localhost:8000/v1/calls \\
  -H "Authorization: Bearer $OFFHOOK_KEY" \\
  -H "Idempotency-Key: confirm-priya-tue" \\
  -H "content-type: application/json" \\
  -d '{
    "agent_id": "<agent-id>",
    "to_number": "+14155550123",
    "context": {"patient_name": "Priya", "appointment_time": "Tuesday at 3 PM"}
  }'`,
  },
];

const features = [
  { term: "Calls", desc: "Outbound and inbound. An async dial queue, idempotency keys so a retried request never rings anyone twice, and clear states from queued to completed." },
  { term: "Agents", desc: "Instructions, an opening line, a voice and a model for each agent. Built-in tools to record results and end the call, plus your own HTTP tools for live data mid-call." },
  { term: "Providers", desc: "Deepgram for speech-to-text. Cartesia or OpenAI for text-to-speech. Groq, Gemini, OpenAI or OpenRouter for the model. Plivo or Twilio for the phone line." },
  { term: "Call records", desc: "An event timeline, transcript, recording, structured outcome and stable error code for every call. Signed webhooks with retries for every change." },
  { term: "Security", desc: "Provider keys stored with per-tenant envelope encryption, using a master key from the environment or AWS KMS. Hashed API keys, an SSRF guard and log redaction." },
  { term: "Limits", desc: "Per-tenant rate limits, concurrent-call caps and monthly quotas, with usage metered in billable seconds." },
];

const quickstart = `git clone https://github.com/welldunai/offhook.git
cd offhook
uv venv && source .venv/bin/activate
uv pip install -e .

# add your Deepgram, Cartesia and Groq keys
cp .env.example .env

# Postgres, migrations, a dev tenant and a demo agent
docker compose up -d
alembic upgrade head
python -m app.admin seed-dev \\
  --voice-id 05a69c2d-457a-4802-8f91-628cb158b522

# then open http://localhost:8000 and start talking
python run.py`;
---

<Base
  title="Offhook — describe the call, an AI agent makes it"
  description="Describe a call in plain English and Offhook's AI agent makes it: it holds the conversation, records the answers and gives you the transcript. For recruiting, appointments, sales and any routine call. Open source."
>
  <section class="hero hero--composer wd-container">
    <div class="hero-copy">
      <p class="wd-eyebrow">AI phone agent<span class="wd-eyebrow-sep">·</span>Open source</p>
      <h1 class="display-xl">Describe the call. Offhook makes&nbsp;it.</h1>
      <p class="lede body-lg">
        Tell it in plain English who it's calling and what you need to find out. It holds the
        conversation, records the answers, and gives you the transcript.
      </p>
      <p class="hero-meta">For recruiting, appointments, sales follow-ups, and any other routine call.</p>
    </div>
    <CallComposer />
  </section>

  <section class="section" id="use-cases" aria-labelledby="uc-title"><div class="wd-container"><div class="section-inner">
    <div class="section-head">
      <p class="wd-eyebrow">Examples</p>
      <h2 id="uc-title" class="display-md">Calls teams hand to Offhook.</h2>
    </div>
    <div class="uc-grid">
      {USE_CASES.map((u) => (
        <a class="wd-card uc-card" href={`/use-cases/${u.slug}/`}>
          <div class="wd-card-top"><p class="wd-eyebrow">{u.team}</p></div>
          <h3 class="wd-card-title">{u.title}</h3>
          <p class="wd-card-desc">{u.summary}</p>
          <ul class="uc-fields" aria-label="What the agent records">
            {u.fields.map((f) => <li>{f.key}</li>)}
          </ul>
          <div class="wd-card-meta"><span>Hear a sample call</span><span class="wd-card-go" aria-hidden="true">→</span></div>
        </a>
      ))}
    </div>
  </div></div></section>

  <section class="section" id="for-teams" aria-labelledby="teams-title"><div class="wd-container"><div class="section-inner">
    <div class="section-head">
      <p class="wd-eyebrow">How it works</p>
      <h2 id="teams-title" class="display-md">From a sentence to a finished call.</h2>
    </div>
    <ol class="team-steps">
      {teamSteps.map((s, i) => (
        <li>
          <span class="step-no">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="title">{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
  </div></div></section>

  <section class="section dev-intro" id="developers" aria-labelledby="dev-title"><div class="wd-container"><div class="section-inner">
    <div class="section-head">
      <p class="wd-eyebrow">For developers</p>
      <h2 id="dev-title" class="display-md">Open source. Your keys, your servers.</h2>
      <p class="body-lg dev-lede">
        Offhook is an API you can run yourself. It uses your own speech, voice, model and phone
        carrier accounts, keeps a full record of every call, and is licensed under Apache-2.0.
      </p>
    </div>
  </div></div></section>

  <section class="section section--tight" id="how" aria-labelledby="how-title"><div class="wd-container"><div class="section-inner">
    <div class="section-head">
      <p class="wd-eyebrow">The API</p>
      <h2 id="how-title" class="display-md">Three requests to a real phone call.</h2>
    </div>
    <div class="how">
      <ol class="steps">
        {steps.map((s, i) => (
          <li>
            <span class="step-no">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h3 class="title">{s.title}</h3>
              <p>{s.body}</p>
            </div>
          </li>
        ))}
      </ol>
      <Code tabs={stepCode} />
    </div>
  </div></div></section>

  <section class="section" id="features" aria-labelledby="features-title"><div class="wd-container"><div class="section-inner">
    <div class="section-head">
      <p class="wd-eyebrow">What's included</p>
      <h2 id="features-title" class="display-md">The plumbing a production call needs.</h2>
    </div>
    <dl class="spec">
      {features.map((f) => (
        <div class="spec-row">
          <dt>{f.term}</dt>
          <dd>{f.desc}</dd>
        </div>
      ))}
    </dl>
  </div></div></section>

  <section class="section" id="quickstart" aria-labelledby="qs-title"><div class="wd-container"><div class="section-inner">
    <div class="qs">
      <div class="qs-copy">
        <p class="wd-eyebrow">Quickstart</p>
        <h2 id="qs-title" class="display-md">Talk to an agent in your browser first.</h2>
        <p class="body-lg qs-lede">
          You don't need a phone number to start. The playground runs the same pipeline over your
          microphone. You need Python 3.13, Docker, and free-tier keys from Deepgram, Cartesia and Groq.
        </p>
        <div class="wd-row">
          <a class="wd-btn wd-btn--secondary" href="/docs/quickstart/">Read the full quickstart</a>
          <a class="wd-btn wd-btn--ghost" href="https://blog.welldun.ai">How we built it <span class="wd-btn-arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
      <Code tabs={[{ label: "Terminal", code: quickstart }]} />
    </div>
  </div></div></section>
</Base>
