---
import DocsLayout from "../../layouts/DocsLayout.astro";
import Code from "../../components/docs/Code.astro";
import Callout from "../../components/docs/Callout.astro";
import Endpoint from "../../components/docs/Endpoint.astro";
import Params from "../../components/docs/Params.astro";
const EVENTS = [
  // [event, status pill modifier ("" = neutral), when it is sent]
  ["call.queued", "", "The call was accepted and is waiting to be dialed."],
  ["call.dialing", "wd-status--dialing", "The carrier is dialing the number."],
  ["call.in_progress", "wd-status--live", "The call connected and the conversation is live."],
  ["call.completed", "wd-status--done", "The call ended normally. Includes the outcome summary, duration and number of turns."],
  ["call.failed", "wd-status--failed", "The call ended in an error. Includes an error_code."],
  ["call.received", "", "An inbound call arrived on one of your numbers."],
  ["carrier.hangup", "", "The carrier reported why the call ended (busy, no answer and so on)."],
];
---

<DocsLayout title="Webhooks" lead="Get a signed HTTP request for every call event instead of polling. Failed deliveries are retried with increasing delays, up to 8 attempts." slug="webhooks">
        <h2 id="register">Register an endpoint</h2>
        <Endpoint method="POST" path="/v1/webhooks" />
        <Params rows={[
          { name: "url", type: "string", required: true, desc: "A public HTTPS URL that receives the POSTs. Private and loopback addresses are rejected." },
          { name: "events", type: "string[]", desc: "The event types to send. Leave it empty to get every event." },
        ]} />
        <Code tabs={[{ label: "cURL", lang: "bash", code: `curl -X POST http://localhost:8000/v1/webhooks \\
  -H "Authorization: Bearer $OFFHOOK_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{ "url": "https://you.example.com/hook", "events": [] }'` }, { label: "Response", lang: "json", code: `{
  "id": "2f7b9d4a-8c1e-4b3f-a6d2-9e5c1f7a3b80",
  "url": "https://you.example.com/hook",
  "events": [],
  "enabled": true,
  "secret": "whsec_…",
  "created_at": "2026-10-15T10:00:00Z"
}` }]} />
        <Callout kind="warn">
          The <code>secret</code> is shown only in this response. You need it to check
          signatures, so store it now.
        </Callout>

        <h2 id="events">Event types</h2>
        <div class="wd-table-wrap">
          <table class="events">
            <thead><tr><th>Event</th><th>Sent when</th></tr></thead>
            <tbody>
              {EVENTS.map(([ev, cls, d]) => (
                <tr>
                  <td><span class:list={["wd-status", cls]}><span class="wd-status-dot" aria-hidden="true" />{ev}</span></td>
                  <td>{d}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h2 id="payload">Payload</h2>
        <p>Each delivery is a POST with a JSON body like this, and these headers:</p>
        <Code tabs={[{ label: "Body", lang: "json", code: `{
  "id": "…",
  "event": "call.completed",
  "created": 1792065645,
  "data": {
    "call_id": "8f2c4d1e-6b7a-4c2e-9f1d-3a5b7c9e1f20",
    "status": "completed",
    "summary": "Confirmed for Tuesday at 3 PM",
    "duration_seconds": 38,
    "turns": 6,
    "error": null
  }
}` }, { label: "Headers", lang: "text", code: `X-Voice-Event:     call.completed
X-Voice-Delivery:  <delivery id>
X-Voice-Signature: t=1792065645,v1=4f1c…` }]} />
        <p>Your endpoint should reply with any <code>2xx</code> status. Anything else counts as a failure and is retried.</p>

        <h2 id="verify">Check the signature</h2>
        <p>
          <code>X-Voice-Signature</code> has the form <code>t=&lt;unix time&gt;,v1=&lt;signature&gt;</code>.
          The signature is an HMAC-SHA256 of <code>&#123;t&#125;.&#123;raw body&#125;</code>, keyed
          with your endpoint's secret. Compute it yourself, compare the two in constant time,
          and reject old timestamps so a captured request can't be replayed.
        </p>
        <Code tabs={[
          { label: "Python", lang: "text", code: `import hmac, hashlib, time

def verify(secret, body, header, tolerance=300):
    parts = dict(p.split("=", 1) for p in header.split(","))
    t, v1 = int(parts["t"]), parts["v1"]
    if abs(time.time() - t) > tolerance:
        return False
    expected = hmac.new(secret.encode(), f"{t}.{body}".encode(),
                        hashlib.sha256).hexdigest()
    return hmac.compare_digest(expected, v1)` },
          { label: "Node", lang: "text", code: `import crypto from "node:crypto";

function verify(secret, body, header, tolerance = 300) {
  const p = Object.fromEntries(header.split(",").map(s => s.split("=")));
  const t = Number(p.t);
  if (Math.abs(Date.now() / 1000 - t) > tolerance) return false;
  const expected = crypto.createHmac("sha256", secret)
    .update(\`\${t}.\${body}\`).digest("hex");
  return crypto.timingSafeEqual(Buffer.from(expected), Buffer.from(p.v1));
}` },
        ]} />
        <Callout kind="note">Use the <strong>raw</strong> request body, exactly as received, before you parse it as JSON.</Callout>

        <h2 id="manage">List and delete</h2>
        <Endpoint method="GET" path="/v1/webhooks" />
        <Endpoint method="DELETE" path="/v1/webhooks/{id}" />

</DocsLayout>
