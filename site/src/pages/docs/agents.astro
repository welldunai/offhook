---
import DocsLayout from "../../layouts/DocsLayout.astro";
import Code from "../../components/docs/Code.astro";
import Callout from "../../components/docs/Callout.astro";
import Endpoint from "../../components/docs/Endpoint.astro";
import Params from "../../components/docs/Params.astro";
---

<DocsLayout title="Agents" lead="An agent is who talks on the call: its instructions, its voice, and the connections it runs on. Create it once and use it for many calls." slug="agents">
        <h2 id="create">Create an agent</h2>
        <Endpoint method="POST" path="/v1/agents" />
        <Params rows={[
          { name: "name", type: "string", required: true, desc: "The name the agent uses on the call." },
          { name: "instructions", type: "string", required: true, desc: "What the agent is for and how it should behave. Offhook adds its own speaking rules (short turns, no markdown) for you." },
          { name: "company", type: "string", desc: "The organisation the agent represents." },
          { name: "role", type: "string", desc: "The agent's role, e.g. <code>scheduling assistant</code>." },
          { name: "first_message", type: "string", desc: "The first thing the agent says when the call connects." },
          { name: "voice_id", type: "string", desc: "Overrides the voice set on the TTS connection." },
          { name: "llm_model", type: "string", desc: "Overrides the model, e.g. <code>llama-3.3-70b-versatile</code>." },
          { name: "stt_connection_id", type: "uuid", required: true, desc: "Speech-to-text connection." },
          { name: "tts_connection_id", type: "uuid", required: true, desc: "Text-to-speech connection." },
          { name: "llm_connection_id", type: "uuid", required: true, desc: "Language model connection." },
          { name: "telephony_connection_id", type: "uuid", desc: "Phone carrier connection. Needed to place or answer phone calls." },
          { name: "provider_settings", type: "object", desc: "Per-provider settings, e.g. <code>{ \"tts\": { \"model\", \"emotion\", \"speed\" }, \"llm\": { \"model\" }, \"language\" }</code>." },
          { name: "tool_ids", type: "uuid[]", desc: "<a href=\"/docs/tools/\">Tools</a> the agent can call during a call." },
        ]} />
        <Code tabs={[{ label: "cURL", lang: "bash", code: `curl -X POST http://localhost:8000/v1/agents \\
  -H "Authorization: Bearer $OFFHOOK_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "name": "Alex",
    "company": "Acme Clinic",
    "instructions": "Confirm the appointment. Offer to reschedule if needed.",
    "first_message": "Hi, this is Alex from Acme Clinic.",
    "stt_connection_id": "<stt-connection-id>",
    "tts_connection_id": "<tts-connection-id>",
    "llm_connection_id": "<llm-connection-id>",
    "telephony_connection_id": "<telephony-connection-id>",
    "provider_settings": {
      "tts": { "model": "sonic-3", "emotion": "warm", "speed": 1.0 },
      "language": "en"
    }
  }'` }, { label: "Response", lang: "json", code: `{
  "id": "3b9e2a7c-1d4f-4e8a-b6c2-5f7a9d1e3c40",
  "name": "Alex",
  "company": "Acme Clinic",
  "instructions": "Confirm the appointment. Offer to reschedule if needed.",
  "first_message": "Hi, this is Alex from Acme Clinic.",
  "stt_connection_id": "…",
  "tts_connection_id": "…",
  "llm_connection_id": "…",
  "telephony_connection_id": "…",
  "provider_settings": { "tts": { "model": "sonic-3", "emotion": "warm", "speed": 1.0 }, "language": "en" },
  "tool_ids": [],
  "created_at": "2026-10-15T10:00:00Z"
}` }]} />
        <Callout kind="note">
          Each connection must belong to your tenant and be the right kind for its field.
          If not, the request returns <code>422</code>.
        </Callout>

        <h2 id="list">List, retrieve and delete</h2>
        <Endpoint method="GET" path="/v1/agents" />
        <Endpoint method="GET" path="/v1/agents/{id}" />
        <Endpoint method="DELETE" path="/v1/agents/{id}" />
        <p>Agents can't be edited yet. To change one, create a new agent and delete the old one.</p>

</DocsLayout>
