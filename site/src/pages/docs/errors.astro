---
import DocsLayout from "../../layouts/DocsLayout.astro";
import Code from "../../components/docs/Code.astro";
import Callout from "../../components/docs/Callout.astro";
const HTTP = [
  ["200, 201", "Success."],
  ["204", "Success with no body, after a delete."],
  ["401", "The API key is missing, wrong, expired or revoked."],
  ["403", "The tenant is deactivated, or a carrier request failed its check."],
  ["404", "Not found. You also get this for things that belong to another tenant."],
  ["409", "Conflict: for example a duplicate name, a connection still in use, or an Idempotency-Key reused with a different body."],
  ["422", "The request is invalid: a field is missing, has the wrong type, or refers to something that doesn't exist."],
  ["429", "Too many requests, or a call quota is reached. Wait for Retry-After, then retry."],
];

const CODES = [
  ["carrier_unauthorized", "The carrier rejected your telephony credentials."],
  ["carrier_error", "The carrier returned an error while dialing."],
  ["busy", "The line was busy."],
  ["no_answer", "Nobody answered before the call timed out."],
  ["rejected", "The call was rejected."],
  ["invalid_number", "The number doesn't exist or isn't in service."],
  ["no_media", "The carrier connected but no audio stream started, for example on a Twilio trial account when the callee didn't press a key."],
  ["config_error", "An agent connection was missing or invalid when the call was dialed."],
  ["provider_timeout", "A speech-to-text, text-to-speech or language model provider timed out."],
  ["pipeline_error", "The conversation pipeline failed during the call."],
  ["unknown_error", "Something failed that doesn't fit the codes above. The call's <code>error</code> field has the details."],
];
---

<DocsLayout title="Errors and limits" lead="Offhook uses standard HTTP status codes. Error responses explain the problem in <code>detail</code>, and failed calls carry an <code>error_code</code> that never changes meaning." slug="errors">
        <Code tabs={[{ label: "Error response", lang: "json", code: `{ "detail": "agent not found" }` }]} />

        <h2 id="http">HTTP status codes</h2>
        <div class="wd-table-wrap">
          <table>
            <thead><tr><th>Status</th><th>Meaning</th></tr></thead>
            <tbody>{HTTP.map(([s, d]) => <tr><td><code>{s}</code></td><td>{d}</td></tr>)}</tbody>
          </table>
        </div>

        <h2 id="codes">Call error codes</h2>
        <p>When a call ends as <code>failed</code>, its <code>error_code</code> (on the call and on the <code>call.failed</code> event) is one of these:</p>
        <div class="wd-table-wrap">
          <table>
            <thead><tr><th>Code</th><th>Meaning</th></tr></thead>
            <tbody>{CODES.map(([c, d]) => <tr><td><code>{c}</code></td><td set:html={d} /></tr>)}</tbody>
          </table>
        </div>

        <h2 id="rate-limits">Rate limits</h2>
        <p>
          Each tenant can make a fixed number of requests per minute (120 by default). Over the
          limit, the API returns <code>429</code> with a <code>Retry-After</code> header. Wait
          that long, then retry.
        </p>

        <h2 id="quotas">Call quotas</h2>
        <p><code>POST /v1/calls</code> also checks two quotas per tenant:</p>
        <ul>
          <li><strong>Concurrent calls:</strong> how many calls can be queued, dialing or in progress at once (10 by default).</li>
          <li><strong>Monthly cap:</strong> an optional limit on calls per calendar month.</li>
        </ul>
        <p>Going over either returns <code>429</code>, with the reason in <code>detail</code>.</p>

        <h2 id="idempotency">Idempotency</h2>
        <p>
          Send an <code>Idempotency-Key</code> header with <code>POST /v1/calls</code> to make
          retries safe. The first request is processed and its response saved. A retry with the
          same key gets that saved response back instead of placing a second call.
        </p>
        <Callout kind="note">
          Reusing a key with a <em>different</em> request body returns <code>409</code>.
        </Callout>

</DocsLayout>
