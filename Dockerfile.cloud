# Hosted Offhook on Cloudflare Containers (CLOUDFLARE.md): the API, the call worker
# and the demo voice server in one process (app/cloud.py), listening on 8080.
# Same base as ./Dockerfile, without the WebRTC playground's dependencies.
# Cloudflare runs linux/amd64.
FROM python:3.13-slim

WORKDIR /app

# Dependencies first, from pyproject.toml alone: this ~1 GB layer then changes only
# when dependencies do, so a code change uploads a few megabytes, not the lot.
COPY pyproject.toml README.md ./
# The cloud never runs the WebRTC dev playground, so Pipecat goes in without its
# webrtc and runner extras and the playground package: no OpenCV, av or aiortc,
# and no libGL (about 500 MB lighter).
COPY deploy/cloudflare/requirements.py /tmp/requirements.py
RUN python /tmp/requirements.py pyproject.toml > /tmp/requirements.txt \
    && pip install --no-cache-dir -r /tmp/requirements.txt

COPY alembic.ini ./
COPY alembic ./alembic
COPY app ./app
RUN pip install --no-cache-dir --no-deps -e .

ENV PYTHONUNBUFFERED=1
EXPOSE 8080

# Migrations first (fast when there's nothing to do), so a new image always meets its schema.
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn app.cloud:app --host 0.0.0.0 --port 8080 --proxy-headers --forwarded-allow-ips '*'"]
