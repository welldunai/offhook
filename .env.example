# ============================================================================
# offhook configuration. Copy to .env and fill in.
# ============================================================================

# ---- Foundation (required) ----
ENV=dev                                    # dev | prod  (prod forbids the playground UI)
DATABASE_URL=postgresql+asyncpg://voice:voice@localhost:5432/voice
# Master key for envelope encryption — base64 of 32 random bytes. Generate:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Lives OUTSIDE the DB; losing it makes stored secrets unrecoverable.
MASTER_ENCRYPTION_KEY=
MASTER_KEY_ID=v1
ENABLE_PREBUILT_UI=1                        # dev playground at /  (must be 0/off in prod)
# DEV_AGENT_ID=                             # set from `python -m app.admin seed-dev`
# PUBLIC_BASE_URL=                          # required in prod: carrier-reachable https URL

# ---- Provider keys below are NOT used directly at call time anymore ----
# Tenants store their own keys via POST /v1/connections (encrypted at rest).
# These env vars are only read by `python -m app.admin seed-dev` to bootstrap a
# dev tenant's connections from your local keys.
DEEPGRAM_API_KEY=          # STT  (seed-dev import)
CARTESIA_API_KEY=          # TTS  (seed-dev import)

# ---- LLM provider + key ----
# provider: groq | gemini | openrouter | openai
#   groq       -> fastest (~300ms TTFB) and free tier. RECOMMENDED for voice.
#   gemini     -> Google direct, free tier. Use gemini-2.5-flash (2.0 is deprecated).
#   openrouter -> many models, but :free ones are slow (multi-second TTFB).
#   openai     -> OpenAI direct.
VOICE_LLM_PROVIDER=groq
VOICE_LLM_MODEL=llama-3.1-8b-instant      # groq: ...-8b-instant (fast) | llama-3.3-70b-versatile (smarter)
GROQ_API_KEY=
# GEMINI_API_KEY=                          # for VOICE_LLM_PROVIDER=gemini (model e.g. gemini-2.5-flash)
# OPENROUTER_API_KEY=                       # for VOICE_LLM_PROVIDER=openrouter
# OPENAI_API_KEY=                           # for VOICE_LLM_PROVIDER=openai (or VOICE_TTS_PROVIDER=openai)

# ---- STT (Deepgram) ----
VOICE_STT_PROVIDER=deepgram
VOICE_STT_MODEL=nova-3

# ---- TTS (Cartesia) ----
VOICE_TTS_PROVIDER=cartesia
VOICE_TTS_MODEL=sonic-3                    # sonic-3 is far more expressive than sonic-2
VOICE_TTS_VOICE_ID=05a69c2d-457a-4802-8f91-628cb158b522
# Sonic-3 delivery controls (optional):
VOICE_TTS_EMOTION=positive and warm        # free-form tone, e.g. "excited", "content", "calm"
VOICE_TTS_SPEED=1.0                        # 0.6 (slow) .. 1.5 (fast)

VOICE_LANGUAGE=en

# ---- Default agent for the prebuilt UI at / (no fields for an agent) ----
# VOICE_DEFAULT_AGENT_NAME=Alex
# VOICE_DEFAULT_AGENT_COMPANY=
# VOICE_DEFAULT_AGENT_INSTRUCTIONS=You are a friendly voice assistant...
# VOICE_DEFAULT_AGENT_FIRST_MESSAGE=Hi! I'm here to help. What can I do for you?

# ---- Telephony — only needed for outbound phone calls (POST /v1/calls) ----
VOICE_TELEPHONY_PROVIDER=plivo
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=         # E.164 caller id, e.g. +14155550123
PUBLIC_BASE_URL=          # public https URL the carrier can reach (e.g. an ngrok tunnel)

# ---- Server ----
HOST=0.0.0.0
PORT=8000
# DEBUG surfaces pipecat's per-stage metrics (TTFB, latency, token/char usage).
# Use INFO to quiet it, TRACE for pipecat's frame-by-frame firehose.
LOG_LEVEL=DEBUG
# Attach pipecat's logging observers (per-stage metrics view). Set 0 to disable.
VOICE_DEBUG_LOGGING=1

# ---- Phase 2: webhooks ----
# DEV ONLY: allow webhook delivery to private/loopback hosts (local receiver testing).
# Must be 0/unset in prod (SSRF). Run the worker with: python -m app.worker
WEBHOOK_ALLOW_PRIVATE=0

# ---- Phase 3: encryption provider + RLS (optional) ----
KEY_PROVIDER=env                # env | kms
# KMS_KEY_ID=                    # required when KEY_PROVIDER=kms (AWS KMS key id/arn)
ENABLE_RLS=0                     # 1 to scope app.current_tenant (needs app/db/rls.sql + two-role setup)

# ---- Dashboard user auth (Clerk) ----
# CLERK_ISSUER=https://your-app.clerk.accounts.dev   # enables Clerk session-JWT login
# CLERK_JWKS_URL=                                     # optional override; derived from issuer

# --- Live demo voice server (python -m app.demo; see DEMO.md) ---------------
# Only needed to run the website's live demo. Not used by the main API.
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=
# GROQ_API_KEY=
# DEMO_LLM_MODEL=openai/gpt-oss-20b
# DEMO_HMAC_SECRET=          # same value as the demo Worker's secret
# WORKER_URL=http://localhost:8787
# DEMO_ALLOWED_ORIGINS=https://offhook.welldun.ai,http://localhost:4321,http://localhost:4370
# DEMO_WORKER_URL=https://demo.offhook.welldun.ai   # docker-compose.demo.yml; defaults to wrangler dev on the host
# CLOUDFLARE_TUNNEL_TOKEN=                          # docker-compose.demo.yml --profile tunnel
