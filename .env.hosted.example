# Hosted Offhook (docker-compose.hosted.yml). Copy to .env.hosted (gitignored).
ENV=prod
LOG_LEVEL=INFO
# The hosted database's password (any long random string), used in both lines.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://offhook:<same password>@db:5432/offhook
# 32 random bytes, base64. Encrypts every workspace's provider keys: back it up
# somewhere safe. Losing it makes stored keys unreadable.
MASTER_ENCRYPTION_KEY=
MASTER_KEY_ID=v1
# Where carriers (Twilio, Plivo) call back. The tunnel's public address.
PUBLIC_BASE_URL=https://api.offhook.welldun.ai
ENABLE_PREBUILT_UI=false
WEBHOOK_ALLOW_PRIVATE=false
# Clerk (dashboard sign-in). The production instance's issuer, e.g. https://clerk.offhook.welldun.ai
CLERK_ISSUER=
# The dashboard's address (and local dev while testing).
CORS_ORIGINS=https://app.offhook.welldun.ai,http://localhost:5173
